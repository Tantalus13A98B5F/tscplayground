{
  "name": "@tscground/checker",
  "version": "0.0.0",
  "exports": "./src/mod.ts",
  "exclude": ["legacy/", "dist/"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true
  },
  "tasks": {
    "check": "deno check src/",
    "test": "deno test --allow-read",
    "test:watch": "deno test --watch --allow-read",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "ci": "deno fmt --check && deno lint && deno check src/ && deno test --allow-read",
    "bundle": "deno bundle --platform browser src/mod.ts -o dist/checker.js",
    "run": "deno run --allow-read src/cli.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/expect": "jsr:@std/expect@^1.0.20"
  }
}
