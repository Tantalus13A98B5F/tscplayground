// Converting between the two encodings, which is where each one's shape shows.
#require "data/nat.ga"
#require "data/list.ga"
#require "church/nat.ga"
#require "church/list.ga"
#require "data/pair.ga"

// Church to datatype needs no recursion at all: the numeral *is* the loop, so
// this is one application and the arguments are the algebra.
let toNat = fn (n: CNat) -> n(fn (x) -> S(x), Z)

// Datatype to Church needs `fix`, a `Nat` carrying no fold of its own. The
// asymmetry is the whole comparison in one pair of bindings.
let toCNat = fix(fn (self: (Nat) -> CNat) -> fn (n: Nat) ->
  match n with
  | Z -> czero
  | S(k) -> csucc(self(k)))

// The one type argument written under `stdlib/`, and the one place staging
// *costs* something. The operator's `t` stands at the fold's `B`, so `z` is
// checked first and fixes `B` alone -- and a bare `Nil()` answers a
// `Nil[never]`, which the operator's `Cons(h, t)` then does not fit. The
// operator's own say on `B` is what was given up to let it go bare. Saying what
// the empty list is empty *of* is the whole of the fix, the same ascription
// Scala's `foldLeft(Nil)` has always needed.
//
// Annotating the operator instead -- `fn (h: A, t: List[A]) -> ...` -- works
// too: it then waits on nothing, is checked alongside `z`, and `B` comes from
// both. One of the two has to say what the fold answers with.
let toList = fn [A](xs: CList[A]) ->
  let empty : List[A] = Nil[A]();
  cfoldr(xs, empty, fn (h, t) -> Cons(h, t))

Pair(toNat(cadd(toCNat(S(Z)), toCNat(S(S(Z))))), length(toList(cnil())))
