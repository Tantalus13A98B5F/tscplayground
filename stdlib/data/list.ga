#require "data/bool.ga"
#require "data/nat.ga"
#require "rec/fix.ga"

datatype List[A] where
| Nil()
| Cons(A, List[A])

let isEmpty = fn [A](xs: List[A]) -> match xs with
| Nil -> True
| Cons(h, t) -> False

// Each of these takes `fix` *inside* the polymorphic lambda, where `A` is a
// rigid variable rather than something still being inferred: the fixed point
// is at a monomorphic arrow, which is all a `Rec[A, B]` can carry. The outer
// `(xs)` is the fixed point applied, so the binding is a function and not the
// combinator.
//
// One parameter list each, and a caller may still pass a bare lambda: the
// checker stages the list itself. `op`'s parameters stand at `A` and `B`, which
// `xs` and `z` say, so those two are checked first and `op` is told both --
// what Scala 2 needs `foldLeft(z)(op)` written out for. What it gives up is
// `op`'s own say on `B`: `z` alone fixes it, which is why a fold from `Nil()`
// has to say what the list is empty of (`uses-both.ga`).
//
// A binder still decides scope. `fn [A, B](xs: List[A]) -> fn (z: B) -> ...`
// binds `B` a list too early: it is solved at `(xs)` with nothing constraining
// it, so it is `never` and the next argument is refused against it.
let foldr = fn [A, B](xs: List[A], z: B, op: (A, B) -> B) ->
  fix(fn (self: (List[A]) -> B) -> fn (ys: List[A]) ->
    match ys with
    | Nil -> z
    | Cons(h, t) -> op(h, self(t)))(xs)

let map = fn [A, B](xs: List[A], f: (A) -> B) ->
  fix(fn (self: (List[A]) -> List[B]) -> fn (ys: List[A]) ->
    match ys with
    | Nil -> Nil()
    | Cons(h, t) -> Cons(f(h), self(t)))(xs)

// Through `foldr`, and with a bare lambda, which is the whole point of it.
let length = fn [A](xs: List[A]) -> foldr(xs, Z, fn (h, acc) -> S(acc))

let append = fn [A](xs: List[A], ys: List[A]) ->
  foldr(xs, ys, fn (h, acc) -> Cons(h, acc))
